{
  "manifest_version": 3,
  "name": "TikTok All Favorite Videos Remover",
  "description": "Safely scan, confirm, remove, and verify favorite TikTok videos with an in-page panel and local report.",
  "version": "2.3.3",
  "author": {
    "name": "Gabriel de Rezende Gonçalves",
    "email": "contato@gabireze.com.br",
    "url": "https://gabireze.com.br/"
  },
  "homepage_url": "https://chromewebstore.google.com/detail/tiktok-all-favorite-video/cbjkccccmffolddklbkedlndlfokcpbn",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": ["https://www.tiktok.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["script.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    },
    "default_title": "TikTok All Favorite Video Remover",
    "default_popup": "popup.html"
  },
  "default_locale": "en"
}
